---
import Layout from '../layouts/Layout.astro';

const values = [
  { title: 'Precision', body: 'Every box is cut, scored, and printed to exact specification. We don\'t ship until it\'s right.' },
  { title: 'Turnaround', body: 'Five working days on standard orders. We know your deadlines matter.' },
  { title: 'Transparency', body: 'You see a digital proof before anything goes to press. No hidden costs, no surprises.' },
  { title: 'Scale', body: 'From 50-unit prototypes to 10,000-unit production runs — same quality either way.' },
];
---

<Layout title="About">

  <section class="max-w-6xl mx-auto px-6 py-20">

    <!-- Intro -->
    <div class="max-w-2xl mb-20">
      <div class="text-xs uppercase tracking-widest text-stone-400 mb-4">Who we are</div>
      <h1 class="font-display text-5xl text-stone-900 mb-6 leading-tight">
        Packaging that does the job right
      </h1>
      <p class="text-stone-500 text-lg leading-relaxed mb-4">
        Boxcraft is a Johannesburg-based custom packaging manufacturer. We work with e-commerce brands, retailers, food producers, and anyone who needs a box that's built exactly to their product.
      </p>
      <p class="text-stone-500 text-lg leading-relaxed">
        We started in 2018 with a single die-cutter and a focus on getting small orders right. Today we run a full production floor and ship across South Africa, but the focus hasn't changed.
      </p>
    </div>

    <!-- Photo placeholder -->
    <div class="w-full h-72 bg-stone-100 border border-stone-200 rounded-xl mb-20 flex items-center justify-center">
      <span class="text-stone-300 text-sm">Workshop photo</span>
    </div>

    <!-- Values -->
    <div class="mb-20">
      <div class="text-xs uppercase tracking-widest text-stone-400 mb-10">What we stand for</div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {values.map(v => (
          <div class="border-t border-stone-200 pt-6">
            <h3 class="font-display text-2xl text-stone-900 mb-3">{v.title}</h3>
            <p class="text-stone-500 text-sm leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Team -->
    <div class="mb-20">
      <div class="text-xs uppercase tracking-widest text-stone-400 mb-10">The team</div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {['Founder', 'Production manager', 'Design lead', 'Sales'].map(role => (
          <div>
            <div class="w-full aspect-square bg-stone-100 border border-stone-200 rounded-lg mb-4 flex items-center justify-center">
              <span class="text-stone-300 text-xs">Photo</span>
            </div>
            <div class="font-medium text-stone-900 text-sm">Team member</div>
            <div class="text-xs text-stone-400 mt-0.5">{role}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-stone-900 text-white rounded-xl p-10 text-center">
      <h2 class="font-display text-3xl mb-3">Ready to get started?</h2>
      <p class="text-stone-400 text-sm mb-6">Tell us what you need and we'll quote you within one business day.</p>
      <a href="/#quote" class="inline-block bg-amber-600 hover:bg-amber-700 text-white px-8 py-3.5 rounded text-sm font-medium transition-colors">
        Request a quote
      </a>
    </div>

  </section>

</Layout>
