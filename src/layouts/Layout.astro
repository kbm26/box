---
import '../styles/global.css';
const { title = 'BoxCraft' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · BoxCraft</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-stone-50 text-stone-900 font-sans antialiased">

    <nav class="fixed top-0 left-0 right-0 z-50 bg-stone-50/90 backdrop-blur-sm border-b border-stone-200">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-display text-xl tracking-tight text-stone-900">
          Box<span class="text-amber-600">craft</span>
        </a>
        <div class="hidden md:flex items-center gap-8">
          <a href="/products" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">Products</a>
          <a href="/gallery" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">Gallery</a>
          <a href="/about" class="text-sm text-stone-500 hover:text-stone-900 transition-colors">About</a>
          <a href="/#quote" class="text-sm bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded transition-colors">
            Get a quote
          </a>
        </div>
        <!-- Mobile menu button -->
        <button id="menu-btn" class="md:hidden p-2" aria-label="Menu">
          <div class="w-5 h-0.5 bg-stone-900 mb-1"></div>
          <div class="w-5 h-0.5 bg-stone-900 mb-1"></div>
          <div class="w-5 h-0.5 bg-stone-900"></div>
        </button>
      </div>
      <!-- Mobile drawer -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-stone-200 bg-stone-50 px-6 py-4 flex flex-col gap-4">
        <a href="/products" class="text-sm text-stone-700">Products</a>
        <a href="/gallery" class="text-sm text-stone-700">Gallery</a>
        <a href="/about" class="text-sm text-stone-700">About</a>
        <a href="/#quote" class="text-sm bg-amber-600 text-white px-4 py-2 rounded text-center">Get a quote</a>
      </div>
    </nav>

    <main class="pt-16">
      <slot />
    </main>

    <footer class="bg-stone-900 text-stone-300 mt-24">
      <div class="max-w-6xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-3 gap-10">
        <div>
          <div class="font-display text-xl text-white mb-3">Box<span class="text-amber-500">craft</span></div>
          <p class="text-sm text-stone-400 leading-relaxed">Custom packaging made exactly to your specification. Johannesburg, South Africa.</p>
        </div>
        <div>
          <div class="text-xs uppercase tracking-widest text-stone-500 mb-4">Navigate</div>
          <div class="flex flex-col gap-2">
            <a href="/products" class="text-sm hover:text-white transition-colors">Products</a>
            <a href="/gallery" class="text-sm hover:text-white transition-colors">Gallery</a>
            <a href="/about" class="text-sm hover:text-white transition-colors">About</a>
            <a href="/#quote" class="text-sm hover:text-white transition-colors">Get a quote</a>
          </div>
        </div>
        <div>
          <div class="text-xs uppercase tracking-widest text-stone-500 mb-4">Contact</div>
          <div class="flex flex-col gap-2 text-sm">
            <a href="mailto:hello@boxcraft.co.za" class="hover:text-white transition-colors">hello@boxcraft.co.za</a>
            <span>+27 11 000 0000</span>
            <span class="text-stone-400">Johannesburg, Gauteng</span>
          </div>
        </div>
      </div>
      <div class="border-t border-stone-800 max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
        <span class="text-xs text-stone-500">© 2026 Boxcraft. All rights reserved.</span>
        <span class="text-xs text-stone-600">Custom packaging · Made in JHB</span>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    </script>

  </body>
</html>

<style is:global>
  .font-display { font-family: 'DM Serif Display', serif; }
  .font-sans { font-family: 'DM Sans', sans-serif; }
</style>
